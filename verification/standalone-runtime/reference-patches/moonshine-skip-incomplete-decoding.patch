 #define MOONSHINE_FLAG_SPELLING_MODE (1 << 1)
+/* Transcribro extension for moonshine_transcribe_stream on streaming models.
+   Advance all supplied audio through VAD, frontend, and encoder, but skip
+   decoder work for unfinished lines during this call. Existing unfinished
+   text and word metadata are retained; a new unfinished line has no text yet.
+   Completed lines always receive normal full decoding and token budgets.
+   The flag never completes a line, changes confirmation, or persists to the
+   next call. It does not override the normal transcription interval. */
+#define MOONSHINE_FLAG_SKIP_INCOMPLETE_DECODING (1u << 2)
 
