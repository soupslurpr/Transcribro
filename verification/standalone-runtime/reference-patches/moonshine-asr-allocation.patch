+namespace {
+void check_asr_status(const OrtApi *ort_api, OrtStatus *status) {
+  if (status == nullptr) return;
+  const std::string message = ort_api->GetErrorMessage(status);
+  ort_api->ReleaseStatus(status);
+  throw std::runtime_error(message);
+}
+}  // namespace
+
+std::shared_ptr<OrtEnv> ort_create_asr_env(const OrtApi *ort_api,
+                                        OrtLoggingLevel logging_level,
+                                        const char *logid) {
+  // Publish only fully configured environments. The weak cache retains no
+  // owner after the last ASR model releases its sessions and custom allocators.
+  static std::mutex mutex;
+  static std::weak_ptr<OrtEnv> cached;
+  std::lock_guard<std::mutex> lock(mutex);
+  if (auto current = cached.lock()) return current;
+
+  OrtEnv *raw_env = nullptr;
+  check_asr_status(ort_api,
+                   ort_create_env(ort_api, logging_level, logid, &raw_env));
+  std::shared_ptr<OrtEnv> owner(raw_env, [ort_api](OrtEnv *env) {
+    ort_api->ReleaseEnv(env);
+  });
+  OrtMemoryInfo *raw_info = nullptr;
+  check_asr_status(ort_api, ort_api->CreateCpuMemoryInfo(
+                                OrtArenaAllocator, OrtMemTypeDefault, &raw_info));
+  std::unique_ptr<OrtMemoryInfo, decltype(ort_api->ReleaseMemoryInfo)> info(
+      raw_info, ort_api->ReleaseMemoryInfo);
+  const char *keys[] = {"max_mem", "arena_extend_strategy"};
+  // Bound arena growth and request exact extensions rather than doubling.
+  // This does not bound model buffers, direct reservations, or total process RSS.
+  const size_t values[] = {512ULL * 1024 * 1024, 1};
+  OrtArenaCfg *raw_config = nullptr;
+  check_asr_status(ort_api,
+                   ort_api->CreateArenaCfgV2(keys, values, 2, &raw_config));
+  std::unique_ptr<OrtArenaCfg, decltype(ort_api->ReleaseArenaCfg)> config(
+      raw_config, ort_api->ReleaseArenaCfg);
+  // GetSharedAllocator has a raw CPU fallback in ORT 1.23.2 and cannot detect
+  // this registration. The shared owner above determines its lifetime instead.
+  check_asr_status(ort_api, ort_api->CreateAndRegisterAllocator(
+                                owner.get(), info.get(), config.get()));
+  cached = owner;
+  return owner;
+}
+
+OrtSessionOptions *ort_create_asr_session_options(const OrtApi *ort_api,
+                                                  bool prepack) {
+  OrtSessionOptions *raw_options = nullptr;
+  check_asr_status(ort_api, ort_api->CreateSessionOptions(&raw_options));
+  std::unique_ptr<OrtSessionOptions, decltype(ort_api->ReleaseSessionOptions)>
+      options(raw_options, ort_api->ReleaseSessionOptions);
+  ort_maybe_force_single_thread(ort_api, options.get());
+  check_asr_status(ort_api, ort_api->SetSessionGraphOptimizationLevel(
+                                options.get(), ORT_ENABLE_EXTENDED));
+  const char *keys[] = {"session.load_model_format",
+                        "session.use_ort_model_bytes_directly",
+                        "session.use_ort_model_bytes_for_initializers",
+                        "session.use_env_allocators",
+                        "session.disable_prepacking"};
+  const char *values[] = {"ORT", "1", "1", "1", prepack ? "0" : "1"};
+  for (size_t i = 0; i < sizeof(keys) / sizeof(keys[0]); ++i) {
+    check_asr_status(ort_api, ort_api->AddSessionConfigEntry(
+                                  options.get(), keys[i], values[i]));
+  }
+  // Model bytes outlive every session, so eligible initializers alias them.
+  // Disable memory patterns to avoid ORT 1.23.2 reserving an unused initializer
+  // slab. The shared CPU arena still reuses activation allocations. Only the
+  // repeatedly executed streaming decoder prepares packed weights; other
+  // components avoid that extra retained memory.
+  check_asr_status(ort_api, ort_api->EnableCpuMemArena(options.get()));
+  check_asr_status(ort_api, ort_api->DisableMemPattern(options.get()));
+  return options.release();
 }
 
