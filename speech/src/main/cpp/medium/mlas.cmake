# Compile the pinned numerical-kernel library in its upstream standalone mode.
# There are no ORT graph, session, allocator or thread-pool dependencies.
if(NOT EXISTS "${ORT_SOURCE}/onnxruntime/core/mlas/inc/mlas.h")
  message(FATAL_ERROR "ORT_SOURCE must point to ONNX Runtime a83fc4d58cb48eb68890dd689f94f28288cf2278")
endif()
set(ONNXRUNTIME_ROOT "${ORT_SOURCE}/onnxruntime")
set(onnxruntime_ORT_MINIMAL_BUILD ON)
set(onnxruntime_BUILD_SHARED_LIB ON)
set(CMAKE_POSITION_INDEPENDENT_CODE ON)
find_package(Threads REQUIRED)
function(onnxruntime_add_static_library name)
  add_library(${name} STATIC ${ARGN})
endfunction()
function(onnxruntime_add_include_to_target)
endfunction()
function(onnxruntime_add_executable name)
  add_executable(${name} EXCLUDE_FROM_ALL ${ARGN})
endfunction()
# CMake 3.22 supports the compiler/dispatch logic. Replace only the 3.25
# variable-scope block used for IDE source grouping with an equivalent function.
file(READ "${ORT_SOURCE}/cmake/onnxruntime_mlas.cmake" mlas_cmake)
string(REPLACE "endblock()" "endfunction()\ntranscribro_mlas_source_groups()" mlas_cmake "${mlas_cmake}")
string(REPLACE "block()" "function(transcribro_mlas_source_groups)" mlas_cmake "${mlas_cmake}")
file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/mlas-sources.cmake" "${mlas_cmake}")
include("${CMAKE_CURRENT_BINARY_DIR}/mlas-sources.cmake")
# Keep FP32 CPU dispatch (including AVX512) without pulling unused 4-bit
# quantization utilities and their graph-runtime common headers into the build.
file(READ "${MLAS_SRC_DIR}/platform.cpp" platform_source)
foreach(unused "this->FpQ4GemmDispatch = &MlasFpQ4GemmDispatchAvx512;" "this->Q8Q4GemmDispatch = &MlasQ8Q4GemmDispatchAvx512vnni;")
  string(FIND "${platform_source}" "${unused}" found)
  if(found EQUAL -1)
    message(FATAL_ERROR "Unexpected MLAS dispatch source")
  endif()
  string(REPLACE "${unused}" "// Transcribro: unused 4-bit dispatch omitted." platform_source "${platform_source}")
endforeach()
file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/mlas-platform.cpp" "${platform_source}")
get_target_property(mlas_sources onnxruntime_mlas SOURCES)
list(REMOVE_ITEM mlas_sources "${MLAS_SRC_DIR}/platform.cpp")
set_property(TARGET onnxruntime_mlas PROPERTY SOURCES "${mlas_sources};${CMAKE_CURRENT_BINARY_DIR}/mlas-platform.cpp")
target_include_directories(onnxruntime_mlas PRIVATE "${ONNXRUNTIME_ROOT}")
target_compile_definitions(onnxruntime_mlas PRIVATE BUILD_MLAS_NO_ONNXRUNTIME)
target_compile_options(onnxruntime_mlas PRIVATE -ffunction-sections -fdata-sections)
target_compile_options(onnxruntime_mlas PRIVATE "$<$<COMPILE_LANGUAGE:CXX>:-includeunistd.h>" "$<$<COMPILE_LANGUAGE:CXX>:-includecstring>")
target_link_options(transcribro_standalone PRIVATE -Wl,--gc-sections -Wl,--no-undefined)
